<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One project, one DLL per Revit version.
    Build:  dotnet build -c Release -p:RevitVersion=2025
    Revit 2023-2024 -> .NET Framework 4.8
    Revit 2025-2026 -> .NET 8
    Revit 2027      -> .NET 10
  -->
  <PropertyGroup>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <TargetFramework Condition="'$(RevitVersion)' &lt;= '2024'">net48</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' == '2025' Or '$(RevitVersion)' == '2026'">net8.0-windows</TargetFramework>
    <TargetFramework Condition="'$(RevitVersion)' &gt;= '2027'">net10.0-windows</TargetFramework>

    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\$(RevitVersion)\</OutputPath>
    <DefineConstants>$(DefineConstants);REVIT$(RevitVersion)</DefineConstants>
    <!-- Revit locks the DLL while running; deploy only from Debug builds. -->
    <DeployToRevit Condition="'$(Configuration)' == 'Debug'">true</DeployToRevit>
  </PropertyGroup>

  <!-- Revit API reference assemblies from NuGet: no Revit install needed to compile.
       ExcludeAssets=runtime stops RevitAPI.dll being copied next to your DLL. -->
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\*.png" />
    <None Include="MyRevitAddin.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Debug convenience: copy manifest + DLL to the per-user add-ins folder. -->
  <Target Name="DeployToRevit" AfterTargets="Build" Condition="'$(DeployToRevit)' == 'true' And '$(OS)' == 'Windows_NT'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\$(RevitVersion)\</RevitAddinsDir>
    </PropertyGroup>
    <Copy SourceFiles="$(OutputPath)MyRevitAddin.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Copy SourceFiles="$(OutputPath)MyRevitAddin.dll;$(OutputPath)MyRevitAddin.pdb" DestinationFolder="$(RevitAddinsDir)MyRevitAddin\" />
  </Target>

</Project>
