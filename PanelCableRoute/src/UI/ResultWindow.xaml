<Window x:Class="PanelCableRoute.UI.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel cable routes" Width="1180" Height="820"
        MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#F1F4F9" FontFamily="Segoe UI" FontSize="12"
        Foreground="#1E293B" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#64748B"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="BorderBrush" Value="#CBD5E1"/>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0,10,0,0"/>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="8"
                    Padding="14,8" Margin="0,0,6,0">
              <ContentPresenter ContentSource="Header"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#E2E8F0"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="White"/>
                <Setter Property="Foreground" Value="#1D4ED8"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#2563EB"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="16,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#1D4ED8"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Background" Value="#94A3B8"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SecondaryButton" TargetType="Button">
      <Setter Property="Foreground" Value="#334155"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="12,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="#CBD5E1" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button"
           BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Height" Value="26"/>
      <Setter Property="Padding" Value="9,0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Margin" Value="4,0,0,0"/>
    </Style>
    <Style x:Key="Swatch" TargetType="Border">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Height" Value="11"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>
    <Style x:Key="SwatchText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5"/>
      <Setter Property="Foreground" Value="#475569"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,11,0"/>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False"/>
      <Setter Property="CanUserAddRows" Value="False"/>
      <Setter Property="CanUserDeleteRows" Value="False"/>
      <Setter Property="CanUserResizeRows" Value="False"/>
      <Setter Property="HeadersVisibility" Value="Column"/>
      <Setter Property="GridLinesVisibility" Value="Horizontal"/>
      <Setter Property="HorizontalGridLinesBrush" Value="#EEF2F7"/>
      <Setter Property="BorderBrush" Value="#E2E8F0"/>
      <Setter Property="RowBackground" Value="White"/>
      <Setter Property="AlternatingRowBackground" Value="#FBFCFE"/>
      <Setter Property="SelectionMode" Value="Single"/>
      <Setter Property="SelectionUnit" Value="FullRow"/>
      <Setter Property="RowHeight" Value="26"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Border Grid.Row="0" Padding="24,14">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Color="#1E3A8A" Offset="0"/>
          <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="10"
                Background="#33FFFFFF" Margin="0,0,14,0">
          <Path Stroke="White" StrokeThickness="2.4" StrokeLineJoin="Round"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Data="M 3,21 L 10,21 L 14,5 L 18,21 L 25,21"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Panel cable routes" FontSize="18"
                     FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="HeadlineText" FontSize="12" Foreground="#DBEAFE"
                     Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <TabControl Grid.Row="1" Margin="18,12,18,0" BorderThickness="0">

      <!-- 3D preview -->
      <TabItem x:Name="Tab3d" Header="3D preview">
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Border Style="{StaticResource Swatch}" Background="#94A3B8"
                        Opacity="0.55"/>
                <TextBlock Text="cable tray"
                           Style="{StaticResource SwatchText}"/>
                <Border Style="{StaticResource Swatch}" Background="#2563EB"/>
                <TextBlock Text="panel / equipment"
                           Style="{StaticResource SwatchText}"/>
                <Border Style="{StaticResource Swatch}" Background="#22D3EE"/>
                <TextBlock Text="route" Style="{StaticResource SwatchText}"/>
                <Border Style="{StaticResource Swatch}" Background="#EF4444"/>
                <TextBlock Text="over the limit"
                           Style="{StaticResource SwatchText}"/>
                <Border Style="{StaticResource Swatch}" Background="#FACC15"/>
                <TextBlock Text="picked route"
                           Style="{StaticResource SwatchText}"/>
              </WrapPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Iso" Style="{StaticResource SmallButton}"
                        Click="OnViewIso"/>
                <Button Content="Top" Style="{StaticResource SmallButton}"
                        Click="OnViewTop"/>
                <Button Content="Front" Style="{StaticResource SmallButton}"
                        Click="OnViewFront"/>
                <Button Content="Side" Style="{StaticResource SmallButton}"
                        Click="OnViewSide"/>
                <Button Content="Fit" Style="{StaticResource SmallButton}"
                        Click="OnViewFit"/>
              </StackPanel>
            </Grid>
            <Border x:Name="ViewHost" Grid.Row="1" Background="#0F172A"
                    CornerRadius="8" ClipToBounds="True" MinHeight="360"
                    MouseLeftButtonDown="OnViewMouseDown"
                    MouseRightButtonDown="OnViewMouseDown"
                    MouseLeftButtonUp="OnViewMouseUp"
                    MouseRightButtonUp="OnViewMouseUp"
                    MouseMove="OnViewMouseMove"
                    MouseWheel="OnViewMouseWheel">
              <Viewport3D x:Name="Viewport" ClipToBounds="True"/>
            </Border>
            <Grid Grid.Row="2" Margin="0,8,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock x:Name="ViewStatusText" Grid.Column="0"
                         Style="{StaticResource Hint}"
                         VerticalAlignment="Center" Margin="0,0,14,0"/>
              <CheckBox x:Name="ShowTraysCheck" Grid.Column="1"
                        IsChecked="True" VerticalAlignment="Center"
                        VerticalContentAlignment="Center" Margin="0,0,12,0"
                        Checked="OnSceneOptionChanged"
                        Unchecked="OnSceneOptionChanged"
                        ToolTip="Draw the modelled cable tray network the routes follow.">
                <TextBlock Text="Trays" Style="{StaticResource Label}"/>
              </CheckBox>
              <CheckBox x:Name="ShowPanelsCheck" Grid.Column="2"
                        IsChecked="True" VerticalAlignment="Center"
                        VerticalContentAlignment="Center" Margin="0,0,12,0"
                        Checked="OnSceneOptionChanged"
                        Unchecked="OnSceneOptionChanged"
                        ToolTip="Draw a box for every panel and every piece of equipment a route reaches.">
                <TextBlock Text="Panels" Style="{StaticResource Label}"/>
              </CheckBox>
              <CheckBox x:Name="ShowAllRoutesCheck" Grid.Column="3"
                        IsChecked="True" VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        Checked="OnSceneOptionChanged"
                        Unchecked="OnSceneOptionChanged"
                        ToolTip="Draw every route in the table. Untick to show only the route picked in the Routes tab.">
                <TextBlock Text="All routes" Style="{StaticResource Label}"/>
              </CheckBox>
            </Grid>
          </Grid>
        </Border>
      </TabItem>

      <!-- Routes -->
      <TabItem x:Name="TabRoutes" Header="Routes">
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="FilterBox" Grid.Column="0" Margin="0,0,10,0"
                       TextChanged="OnFilterChanged"
                       ToolTip="Type part of a panel name, a circuit number, a level or an ID to narrow the list."/>
              <CheckBox x:Name="OnlyOverCheck" Grid.Column="1"
                        VerticalAlignment="Center" Margin="0,0,10,0"
                        VerticalContentAlignment="Center"
                        Checked="OnFilterToggled" Unchecked="OnFilterToggled"
                        ToolTip="Show only the routes whose voltage drop is over the limit.">
                <TextBlock Text="Over the limit only"
                           Style="{StaticResource Label}"/>
              </CheckBox>
              <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="Tick all" Style="{StaticResource SmallButton}"
                        Click="OnTickAll"/>
                <Button Content="Tick none" Style="{StaticResource SmallButton}"
                        Click="OnTickNone"/>
                <Button Content="Select in Revit"
                        Style="{StaticResource SmallButton}"
                        Click="OnSelectInRevit"/>
                <Button Content="Zoom to" Style="{StaticResource SmallButton}"
                        Click="OnZoomInRevit"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="RouteStatusText" Grid.Row="1"
                       Style="{StaticResource Hint}" Margin="0,0,0,8"/>
            <DataGrid x:Name="RouteGrid" Grid.Row="2" IsReadOnly="False"
                      SelectionChanged="OnRouteSelected">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding WithinLimit}" Value="False">
                      <Setter Property="Background" Value="#FEF2F2"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Draw" Width="46"
                                        SortMemberPath="Include">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <CheckBox IsChecked="{Binding Include, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip="Include this route when drawing and exporting"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Source panel" Width="150"
                                    IsReadOnly="True"
                                    Binding="{Binding SourceName}"/>
                <DataGridTextColumn Header="Destination" Width="150"
                                    IsReadOnly="True"
                                    Binding="{Binding DestinationName}"/>
                <DataGridTextColumn Header="Type" Width="78" IsReadOnly="True"
                                    Binding="{Binding KindText}"/>
                <DataGridTextColumn Header="Circuit" Width="78"
                                    IsReadOnly="True"
                                    Binding="{Binding CircuitNumber}"/>
                <DataGridTextColumn Header="Tray (m)" Width="72"
                                    IsReadOnly="True"
                                    Binding="{Binding TrayMetres, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="Ends (m)" Width="72"
                                    IsReadOnly="True"
                                    Binding="{Binding EndMetres, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="Gap (m)" Width="68"
                                    IsReadOnly="True"
                                    Binding="{Binding BridgeMetres, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="Length (m)" Width="84"
                                    IsReadOnly="True"
                                    Binding="{Binding LengthMetres, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="A" Width="56" IsReadOnly="True"
                                    Binding="{Binding Current, StringFormat='{}{0:0.#}'}"/>
                <DataGridTextColumn Header="V" Width="52" IsReadOnly="True"
                                    Binding="{Binding Voltage, StringFormat='{}{0:0}'}"/>
                <DataGridTextColumn Header="Drop (V)" Width="72"
                                    IsReadOnly="True"
                                    Binding="{Binding DropVolts, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="Drop (%)" Width="72"
                                    IsReadOnly="True"
                                    Binding="{Binding DropPercent, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="Status" Width="62"
                                    IsReadOnly="True"
                                    Binding="{Binding Status}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </TabItem>

      <!-- Panels -->
      <TabItem x:Name="TabPanels" Header="Panels">
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource Hint}"
                       Margin="0,0,0,8"
                       Text="One row per panel in scope: how many routes touch it, its longest route and its worst voltage drop. Double-click a row to select the panel in Revit."/>
            <DataGrid x:Name="PanelGrid" Grid.Row="1" IsReadOnly="True"
                      MouseDoubleClick="OnPanelDoubleClick">
              <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasOverLimit}" Value="True">
                      <Setter Property="Background" Value="#FEF2F2"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </DataGrid.RowStyle>
              <DataGrid.Columns>
                <DataGridTextColumn Header="Panel" Width="220"
                                    Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Level" Width="130"
                                    Binding="{Binding LevelName}"/>
                <DataGridTextColumn Header="Routes" Width="80"
                                    Binding="{Binding RouteCount}"/>
                <DataGridTextColumn Header="Longest (m)" Width="100"
                                    Binding="{Binding LongestMetres, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="Worst drop (%)" Width="110"
                                    Binding="{Binding WorstPercent, StringFormat='{}{0:0.00}'}"/>
                <DataGridTextColumn Header="Over limit" Width="90"
                                    Binding="{Binding OverLimit}"/>
                <DataGridTextColumn Header="Bridged" Width="80"
                                    Binding="{Binding Bridged}"/>
                <DataGridTextColumn Header="ID" Width="90"
                                    Binding="{Binding Id}"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Border>
      </TabItem>

      <!-- Overview and issues -->
      <TabItem x:Name="TabIssues" Header="Overview and issues">
        <Border Style="{StaticResource Card}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.1*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
              <TextBlock x:Name="OverviewText" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11.5"/>
            </ScrollViewer>
            <Grid Grid.Column="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Style="{StaticResource Hint}"
                         Margin="0,0,0,8"
                         Text="Equipment that could not be reached, and routes that had to bridge a gap in the modelled trays."/>
              <ListBox x:Name="IssueList" Grid.Row="1" BorderBrush="#E2E8F0"/>
              <Button Grid.Row="2" Content="Select in Revit"
                      Style="{StaticResource SecondaryButton}"
                      HorizontalAlignment="Right" Margin="0,8,0,0"
                      Click="OnSelectIssue"/>
            </Grid>
          </Grid>
        </Border>
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0"
            BorderThickness="0,1,0,0" Padding="18,12" Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Content="Copy report" Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,0" Click="OnCopyReport"/>
          <Button Content="Export CSV" Style="{StaticResource SecondaryButton}"
                  Margin="0,0,8,0" Click="OnExportCsv"/>
          <Button Content="Open in Excel"
                  Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                  Click="OnOpenInExcel"/>
          <Button Content="Close" Style="{StaticResource SecondaryButton}"
                  Margin="0,0,10,0" IsCancel="True" Click="OnClose"/>
          <Button x:Name="DrawButton" Content="Draw detail lines"
                  Style="{StaticResource PrimaryButton}" IsDefault="True"
                  Click="OnDraw"/>
        </StackPanel>
        <Border x:Name="BannerBorder" CornerRadius="6" Padding="10,7"
                BorderThickness="1" VerticalAlignment="Center"
                Margin="0,0,16,0" Background="#F0FDF4" BorderBrush="#BBF7D0">
          <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="11.5"
                     Foreground="#166534"/>
        </Border>
      </DockPanel>
    </Border>
  </Grid>
</Window>
