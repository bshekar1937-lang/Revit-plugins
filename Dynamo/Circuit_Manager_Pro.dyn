{
  "Uuid": "ce7118e3-b954-4c9a-8e92-12bfb9939d00",
  "IsCustomNode": false,
  "Description": "Bulk create (one circuit per fixture), move, disconnect, delete and edit electrical circuits.",
  "Name": "Circuit_Manager_Pro",
